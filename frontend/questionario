<main>
<h1>Monte seu mundo ideal</h1>
<p>Marque o que você quer e diga o quanto cada grupo importa. As seeds aparecem ordenadas por compatibilidade.</p>
<form id="form-questionario" class="bloco" action="resultados.html" method="get">
<fieldset><legend>Edição e versão</legend>
<div class="campos">
<div><label for="edicao">Edição do jogo</label><select id="edicao" name="edicao" required><option value="">Escolha</option><option>Java</option><option>Bedrock</option></select></div>
<div><label for="versao">Versão</label><input id="versao" name="versao" maxlength="12" placeholder="1.21" required></div>
</div></fieldset>
<fieldset><legend>Biomas</legend><div class="opcoes"><label><input type="checkbox" name="bioma" value="planicies"> Planícies</label><label><input type="checkbox" name="bioma" value="florestas"> Florestas</label><label><input type="checkbox" name="bioma" value="cherry_grove"> Floresta de cerejeiras</label><label><input type="checkbox" name="bioma" value="montanhas"> Montanhas</label><label><input type="checkbox" name="bioma" value="picos_nevados"> Picos nevados</label><label><input type="checkbox" name="bioma" value="desertos"> Desertos</label><label><input type="checkbox" name="bioma" value="savanas"> Savanas</label><label><input type="checkbox" name="bioma" value="selvas"> Selvas</label><label><input type="checkbox" name="bioma" value="pantanos"> Pântanos</label><label><input type="checkbox" name="bioma" value="manguezais"> Manguezais</label><label><input type="checkbox" name="bioma" value="taiga"> Taiga</label><label><input type="checkbox" name="bioma" value="taiga_nevada"> Taiga nevada</label><label><input type="checkbox" name="bioma" value="oceanos_ilhas"> Oceanos e ilhas</label><label><input type="checkbox" name="bioma" value="badlands"> Badlands</label><label><input type="checkbox" name="bioma" value="cogumelos"> Campos de cogumelos</label><label><input type="checkbox" name="bioma" value="raros"> Biomas raros</label><label><input type="checkbox" name="bioma" value="varios_proximos"> Vários biomas próximos</label></div><div class="peso"><label for="peso_bioma">Importância</label><select id="peso_bioma" name="peso_bioma"><option value="1">1, tenho pouca preferência</option><option value="2" selected>2, é importante</option><option value="3">3, é essencial</option></select></div></fieldset>
<fieldset><legend>Estruturas</legend><div class="opcoes"><label><input type="checkbox" name="estrutura" value="village"> Vila</label><label><input type="checkbox" name="estrutura" value="trial_chambers"> Trial Chambers</label><label><input type="checkbox" name="estrutura" value="ancient_city"> Ancient City</label><label><input type="checkbox" name="estrutura" value="stronghold"> Stronghold</label><label><input type="checkbox" name="estrutura" value="mansion"> Woodland Mansion</label><label><input type="checkbox" name="estrutura" value="pillager_outpost"> Pillager Outpost</label><label><input type="checkbox" name="estrutura" value="desert_temple"> Desert Temple</label><label><input type="checkbox" name="estrutura" value="jungle_temple"> Jungle Temple</label><label><input type="checkbox" name="estrutura" value="ocean_monument"> Ocean Monument</label><label><input type="checkbox" name="estrutura" value="shipwreck"> Shipwreck</label><label><input type="checkbox" name="estrutura" value="ruined_portal"> Ruined Portal</label><label><input type="checkbox" name="estrutura" value="bastion"> Bastion</label><label><input type="checkbox" name="estrutura" value="fortress"> Nether Fortress</label><label><input type="checkbox" name="estrutura" value="mineshaft"> Mineshaft</label><label><input type="checkbox" name="estrutura" value="ocean_ruins"> Ocean Ruins</label><label><input type="checkbox" name="estrutura" value="buried_treasure"> Tesouro enterrado</label></div><div class="peso"><label for="peso_estrutura">Importância</label><select id="peso_estrutura" name="peso_estrutura"><option value="1">1, tenho pouca preferência</option><option value="2" selected>2, é importante</option><option value="3">3, é essencial</option></select></div></fieldset>
<fieldset><legend>Estilo de jogo</legend><div class="opcoes"><label><input type="checkbox" name="estilo" value="survival_tradicional"> Survival tradicional</label><label><input type="checkbox" name="estilo" value="survival_desafiador"> Survival desafiador</label><label><input type="checkbox" name="estilo" value="hardcore"> Hardcore</label><label><input type="checkbox" name="estilo" value="criativo"> Criativo</label><label><input type="checkbox" name="estilo" value="speedrun"> Speedrun</label><label><input type="checkbox" name="estilo" value="exploracao"> Exploração</label><label><input type="checkbox" name="estilo" value="construcao"> Construção</label><label><input type="checkbox" name="estilo" value="multiplayer_coop"> Multiplayer cooperativo</label><label><input type="checkbox" name="estilo" value="ilhas"> Sobrevivência em ilhas</label><label><input type="checkbox" name="estilo" value="cavernas"> Exploração de cavernas</label></div><div class="peso"><label for="peso_estilo">Importância</label><select id="peso_estilo" name="peso_estilo"><option value="1">1, tenho pouca preferência</option><option value="2" selected>2, é importante</option><option value="3">3, é essencial</option></select></div></fieldset>
<button class="btn" type="submit">Ver recomendações</button>
</form>
